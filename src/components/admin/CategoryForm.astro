---
import FieldError from './FieldError.astro';

interface Props {
  action: string;
  method?: 'POST' | 'PATCH';
  submitLabel: string;
  category?: {
    title: string;
    titleEn: string;
    slug: string;
    description: string;
    coverUrl: string | null;
    status: 'draft' | 'published';
  };
}

const { action, method = 'POST', submitLabel, category } = Astro.props;
---

<div class="form-shell">
  <form class="admin-form" id="category-form" data-action={action} data-method={method} novalidate>
    <section class="form-section">
      <h2>基本信息</h2>
      <div class="form-grid">
        <div class="form-field">
          <label for="title">分类名称 *</label>
          <input id="title" name="title" value={category?.title ?? ''} maxlength="80" required />
          <FieldError field="title" />
        </div>
        <div class="form-field">
          <label for="titleEn">英文名称</label>
          <input id="titleEn" name="titleEn" value={category?.titleEn ?? ''} maxlength="80" />
          <FieldError field="titleEn" />
        </div>
        <div class="form-field full">
          <label for="slug">Slug *</label>
          <input id="slug" name="slug" value={category?.slug ?? ''} maxlength="100" placeholder="street-photography" required />
          <p class="field-hint">用于网址，保存时自动转为小写英文与连字符。</p>
          <FieldError field="slug" />
        </div>
        <div class="form-field full">
          <label for="description">分类简介</label>
          <textarea id="description" name="description" maxlength="2000">{category?.description ?? ''}</textarea>
          <FieldError field="description" />
        </div>
      </div>
    </section>

    <section class="form-section">
      <h2>展示设置</h2>
      <div class="form-grid">
        <div class="form-field full">
          <label for="coverUrl">封面图片地址</label>
          <input id="coverUrl" name="coverUrl" type="url" value={category?.coverUrl ?? ''} placeholder="https://..." />
          <p class="field-hint">可使用 HTTPS 外链图片。</p>
          <FieldError field="coverUrl" />
        </div>
        <div class="form-field">
          <label for="status">状态</label>
          <select id="status" name="status">
            <option value="draft" selected={(category?.status ?? 'draft') === 'draft'}>草稿</option>
            <option value="published" selected={category?.status === 'published'}>已发布</option>
          </select>
          <FieldError field="status" />
        </div>
      </div>
    </section>

    <div class="form-actions">
      <button class="button" type="submit">{submitLabel}</button>
      <a class="button-secondary" href="/admin/categories">取消</a>
      <p class="form-message" data-form-message role="alert" hidden></p>
    </div>
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('#category-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const message = form.querySelector<HTMLElement>('[data-form-message]');
    form.querySelectorAll<HTMLElement>('[data-field-error]').forEach((item) => {
      item.hidden = true;
      item.textContent = '';
      form.querySelector(`[name="${item.dataset.fieldError}"]`)?.removeAttribute('aria-invalid');
    });
    if (message) message.hidden = true;
    if (submit) submit.disabled = true;

    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());
    try {
      const response = await fetch(form.dataset.action ?? '', {
        method: form.dataset.method ?? 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (response.ok) {
        window.location.assign('/admin/categories?saved=1');
        return;
      }
      const fields = result.error?.fields ?? {};
      Object.entries(fields).forEach(([field, errors]) => {
        const target = form.querySelector<HTMLElement>(`[data-field-error="${field}"]`);
        const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
        if (target) {
          target.textContent = Array.isArray(errors) ? String(errors[0]) : String(errors);
          target.hidden = false;
        }
        input?.setAttribute('aria-invalid', 'true');
      });
      if (message) {
        message.textContent = result.error?.message ?? '保存失败，请重试。';
        message.hidden = false;
      }
    } catch {
      if (message) {
        message.textContent = '网络异常，请重试。';
        message.hidden = false;
      }
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
