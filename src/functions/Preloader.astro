---
import Noise from "../functions/Noise.astro";
interface Props {
  loading?: string;
  showHero?: boolean;
  images?: string[];
}

const { loading = "MBOKER IMG", showHero = false, images: incomingImages = [] } = Astro.props;
const images = incomingImages.length ? incomingImages : ['/hero-preloader.jpg'];
---

<div class="preloader">

  <div class="loading-block upperone">
    <Noise />
    {showHero ? (
      <div class="preloader-montage" aria-hidden="true">
        {images.map((src) => (
          <img
            src={src}
            class="preloader-montage__image"
            alt=""
            loading="eager"
            decoding="async"
          />
        ))}
      </div>
    ) : (
      <div class="preloader-title preloader-splitting" data-splitting>
        {loading}
      </div>
    )}
  </div>
  <div class="loading-block downone"></div>
  <div class="loading-block downtwo"></div>
</div>

<style lang="scss"  is:global>
  /*
---- loading 效果 ----
*/
  :root{
    --loading-color: #0e100f;
    --loading-bg:#fff;
    --loading-block-01:#fcf2ea;

    --loading-block-02:#ff5a19;
  }
  :root.dark{
    --loading-color: #f7f7f8;
    --loading-bg:#0e100f;
    --loading-block-01:var(--color-900);
  }
  .loading-block {
    position: fixed;
    height: 100%;
    width: 100%;
    top: 0;
    left: 0;
  }
  .upperone {
    background-color:var(--loading-bg);
    z-index: var(--z-preloader);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2rem;
    font-weight: 100;
  }
  .downone {
    background-color: var(--loading-block-01);
    z-index: calc(var(--z-preloader) - 1);
  }
  .downtwo {
    background-color: var(--loading-block-02);
    z-index: calc(var(--z-preloader) - 2);
  }

  .preloader-title {
    font-size: 28px;
    opacity: 0;
    font-weight: normal;
    color: var(--color-100);
    @media screen and (max-width: 767px) {
      font-size: 20px;
    }
  }
  .preloader-montage {
    position: relative;
    width: 320px;
    height: 310px;
  }
  .preloader-montage__image {
    --montage-x: 0px;
    --montage-y: 0px;
    --montage-rotate: 0deg;
    --montage-delay: .16s;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 174px;
    height: 220px;
    object-fit: cover;
    opacity: 0;
    filter: blur(12px);
    box-shadow: 0 16px 42px rgba(14, 16, 15, .14);
    will-change: transform, opacity, filter;
    animation: preloader-montage-in .78s cubic-bezier(.16, 1, .3, 1) var(--montage-delay) both;
  }
  .preloader-montage__image:nth-child(1) { --montage-x: -58px; --montage-y: -22px; --montage-rotate: -8deg; --montage-delay: .16s; }
  .preloader-montage__image:nth-child(2) { --montage-x: 52px; --montage-y: -18px; --montage-rotate: 7deg; --montage-delay: .30s; }
  .preloader-montage__image:nth-child(3) { --montage-x: -38px; --montage-y: 30px; --montage-rotate: -4deg; --montage-delay: .44s; }
  .preloader-montage__image:nth-child(4) { --montage-x: 42px; --montage-y: 26px; --montage-rotate: 5deg; --montage-delay: .58s; }
  .preloader-montage__image:nth-child(5) { --montage-delay: .72s; }
  .preloader-montage.is-leaving .preloader-montage__image {
    animation: preloader-montage-out .42s cubic-bezier(.7, 0, .84, 0) both;
  }
  @keyframes preloader-montage-in {
    from {
      opacity: 0;
      transform: translate(calc(-50% + var(--montage-x)), calc(-50% + var(--montage-y) - 34px)) rotate(calc(var(--montage-rotate) - 4deg)) scale(.92);
      filter: blur(12px);
    }
    to {
      opacity: 1;
      transform: translate(calc(-50% + var(--montage-x)), calc(-50% + var(--montage-y))) rotate(var(--montage-rotate)) scale(1);
      filter: blur(0);
    }
  }
  @keyframes preloader-montage-out {
    from {
      opacity: 1;
      filter: blur(0);
      transform: translate(calc(-50% + var(--montage-x)), calc(-50% + var(--montage-y))) rotate(var(--montage-rotate)) scale(1);
    }
    to {
      opacity: 0;
      filter: blur(24px);
      transform: translate(calc(-50% + var(--montage-x)), calc(-50% + var(--montage-y) - 18px)) rotate(var(--montage-rotate)) scale(.96);
    }
  }
  @media screen and (max-width: 600px) {
    .preloader-montage {
      width: 250px;
      height: 240px;
    }
    .preloader-montage__image {
      width: 138px;
      height: 174px;
    }
    .preloader-montage__image:nth-child(1) { --montage-x: -42px; --montage-y: -16px; }
    .preloader-montage__image:nth-child(2) { --montage-x: 38px; --montage-y: -14px; }
    .preloader-montage__image:nth-child(3) { --montage-x: -28px; --montage-y: 22px; }
    .preloader-montage__image:nth-child(4) { --montage-x: 30px; --montage-y: 20px; }
  }
  .preloader-splitting .splitting .char,
  .preloader-splitting.splitting .char {
    padding: 0 3px;
  }
</style>
