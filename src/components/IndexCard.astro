---
interface FeaturedItem {
  href: string;
  imageUrl: string;
  alt: string;
  category: string;
  title: string;
  date: string;
}

const { items = [] } = Astro.props as { items?: FeaturedItem[] };
---

{items.length > 0 && (
  <section class="container index-gallery">
    <div class="index-grid">
      <div class="index-grid__inner">
        {items.map((item) => (
          <div class="index-card">
            <div class="index-card__inner">
              <a href={item.href} class="index-card__media">
                <picture class="gsap-picture">
                  <img src={item.imageUrl} alt={item.alt} class="index-card__img" loading="lazy" decoding="async" />
                </picture>
              </a>
              <div class="index-card__info">
                <div class="index-card__content">
                  <div class="index-card__index lead ls">
                    <a href={item.href} class="link-solid" data-splitting>→ ({item.category})</a>
                  </div>
                  <h3 class="index-card__title display display--2" data-splitting>{item.title}</h3>
                  {item.date && <div class="lead ls" data-splitting>/ {item.date}</div>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style lang="scss" is:global>
  .index-grid {
    padding-top: 90px;
  }
  @media (min-width: 1200px) {
    .index-grid { padding-top: 180px; }
  }
  .index-grid__inner {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }
  .index-card {
    grid-column: auto / span 12;
    margin-bottom: 20px;
    @media (min-width: 576px) {
      grid-column: auto / span 6;
    }
    @media (min-width: 767px) {
      margin-bottom: 120px;
      &:nth-child(9n + 1) { grid-column: 5 / span 7; margin-top: 120px; }
      &:nth-child(9n + 2) { grid-column: 1 / span 3; }
      &:nth-child(9n + 3) { grid-column: 9 / span 4; margin-top: 15vw; }
      &:nth-child(9n + 4) { grid-column: 2 / span 7; }
      &:nth-child(9n + 5) { grid-column: 8 / span 4; }
      &:nth-child(9n + 6) { grid-column: 2 / span 4; }
      &:nth-child(9n + 7) { grid-column: 4 / span 7; }
      &:nth-child(9n + 8) { grid-column: 8 / span 4; }
      &:nth-child(9n + 9) { grid-column: 3 / span 8; margin-bottom: 8vw; }
    }
    @media (min-width: 1200px) {
      margin-bottom: 200px;
    }
  }
  .index-card__inner {
    position: relative;
  }
  .index-card__media,
  .index-card__media .gsap-picture {
    display: block;
    width: 100%;
  }
  .index-card__img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .index-card__info {
    margin-top: 10px;
  }
  .index-card__title {
    margin: 8px 0 24px;
  }
  @media (min-width: 992px) {
    .index-card__info {
      position: absolute;
    }
    .index-card__title {
      margin: 12px 0 32px;
    }
    .index-card:nth-child(9n + 1) .index-card__info,
    .index-card:nth-child(9n + 3) .index-card__info,
    .index-card:nth-child(9n + 5) .index-card__info,
    .index-card:nth-child(9n + 8) .index-card__info {
      right: auto;
      bottom: 0;
      left: -20px;
      margin: 0;
      text-align: right;
      transform: translateX(-100%);
    }
    .index-card:nth-child(9n + 2) .index-card__info,
    .index-card:nth-child(9n + 4) .index-card__info,
    .index-card:nth-child(9n + 6) .index-card__info,
    .index-card:nth-child(9n + 7) .index-card__info,
    .index-card:nth-child(9n + 9) .index-card__info {
      right: -20px;
      bottom: 0;
      left: auto;
      margin: 0;
      text-align: left;
      transform: translateX(100%);
    }
  }
  .picture {
    position: relative;
    &-wrapper {
      position: relative;
      display: inline-block;
      overflow: hidden;
      width: 100%;
    }
    &__img {
      position: absolute;
      top: 0;
      left: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .5s ease-in-out;
    }
  }
  .picture-wrapper:hover .picture__img {
    transform: scale(1.08);
  }
</style>
