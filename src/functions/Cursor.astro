<div class="mouseRing" data-custom-cursor-ring aria-hidden="true"></div>
<div class="mousePoint" data-custom-cursor-dot aria-hidden="true"></div>

<script>
  const root = document.documentElement;
  const centerDot = document.querySelector<HTMLElement>('[data-custom-cursor-dot]');
  const ring = document.querySelector<HTMLElement>('[data-custom-cursor-ring]');
  const finePointer = window.matchMedia('(pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  root.classList.remove('custom-cursor-ready');
  if (centerDot && ring && finePointer.matches && !reducedMotion.matches) {
    let targetX = 0;
    let targetY = 0;
    let ringX = 0;
    let ringY = 0;
    let animationFrame = 0;
    let initialized = false;

    const renderRing = () => {
      ringX += (targetX - ringX) * 0.18;
      ringY += (targetY - ringY) * 0.18;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
      animationFrame = requestAnimationFrame(renderRing);
    };
    const handlePointerMove = (event: PointerEvent) => {
      targetX = event.clientX;
      targetY = event.clientY;
      centerDot.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) translate(-50%, -50%)`;
      if (!initialized) {
        initialized = true;
        ringX = targetX;
        ringY = targetY;
        ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
        root.classList.add('custom-cursor-ready');
        animationFrame = requestAnimationFrame(renderRing);
      }
    };
    const handlePointerOver = (event: PointerEvent) => {
      if ((event.target as Element | null)?.closest('[data-bigdot="true"]')) root.classList.add('custom-cursor-hover');
    };
    const handlePointerOut = (event: PointerEvent) => {
      if ((event.target as Element | null)?.closest('[data-bigdot="true"]')) root.classList.remove('custom-cursor-hover');
    };
    const cleanup = () => {
      window.removeEventListener('pointermove', handlePointerMove);
      document.removeEventListener('pointerover', handlePointerOver);
      document.removeEventListener('pointerout', handlePointerOut);
      if (animationFrame) cancelAnimationFrame(animationFrame);
      root.classList.remove('custom-cursor-ready', 'custom-cursor-hover');
    };

    window.addEventListener('pointermove', handlePointerMove, { passive: true });
    document.addEventListener('pointerover', handlePointerOver, { passive: true });
    document.addEventListener('pointerout', handlePointerOut, { passive: true });
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>

<style>
  html.custom-cursor-ready,
  html.custom-cursor-ready body,
  html.custom-cursor-ready a,
  html.custom-cursor-ready button,
  html.custom-cursor-ready input,
  html.custom-cursor-ready select,
  html.custom-cursor-ready textarea { cursor: none; }
  .mousePoint, .mouseRing {
    position: fixed;
    z-index: calc(var(--z-cursor) + 1);
    top: 0;
    left: 0;
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }
  .mousePoint { width: 8px; height: 8px; background: var(--color-50); }
  .mouseRing { z-index: var(--z-cursor); width: 40px; height: 40px; border: 1px solid #606060; transition: width .2s ease, height .2s ease, border-color .2s ease; }
  html.custom-cursor-ready .mousePoint, html.custom-cursor-ready .mouseRing { opacity: 1; }
  html.custom-cursor-hover .mouseRing { width: 58px; height: 58px; border-color: var(--color-50); }
  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .mousePoint, .mouseRing { display: none; }
  }
</style>
