---
import { AlertTriangle } from 'lucide-astro';

interface Props {
  id: string;
  title?: string;
}

const { id, title = '确认删除' } = Astro.props;
---

<dialog class="confirm-dialog" id={id} aria-labelledby={`${id}-title`}>
  <div class="confirm-icon"><AlertTriangle size={20} aria-hidden="true" /></div>
  <h2 id={`${id}-title`}>{title}</h2>
  <p>确定要删除「<strong data-confirm-name></strong>」吗？此操作无法撤销。</p>
  <p class="dialog-error" data-dialog-error role="alert" hidden></p>
  <div class="dialog-actions">
    <button type="button" class="button-secondary" data-dialog-cancel>取消</button>
    <button type="button" class="button-danger" data-dialog-confirm>删除</button>
  </div>
</dialog>
