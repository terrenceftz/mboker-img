---
import { Crown, GripVertical, LayoutTemplate, Link, Pencil, Trash2 } from 'lucide-astro';

interface Photo {
  id: number;
  originalUrl: string;
  thumbnailUrl: string | null;
  sourceType: 'upload' | 'external';
  alt: string;
  width: number | null;
  height: number | null;
  layoutPreset: 'auto' | 'wide' | 'standard' | 'narrow';
  align: 'start' | 'center' | 'end';
  hasBackground: boolean;
  padding: string;
  layoutJson: {
    pairWithNext?: boolean;
    pairRatio?: '1:1' | '2:3' | '3:2';
    verticalAlign?: 'start' | 'center' | 'end';
  };
}
interface Props { albumId: number; coverPhotoId: number | null; photos: Photo[]; }
const { albumId, coverPhotoId, photos } = Astro.props;
---

<section class="photo-library" data-photo-library data-album-id={albumId}>
  <div class="photo-library-toolbar">
    <label class="selection-toggle"><input type="checkbox" data-select-all />全选</label>
    <span data-selected-count>已选 0 张</span>
    <div class="batch-layout-controls" data-batch-layout>
      <select aria-label="批量版式" data-batch-preset>
        <option value="auto">自动</option><option value="wide">宽幅</option><option value="standard">标准</option><option value="narrow">窄幅</option>
      </select>
      <select aria-label="批量对齐" data-batch-align>
        <option value="start">左对齐</option><option value="center" selected>居中</option><option value="end">右对齐</option>
      </select>
      <input aria-label="批量留白" maxlength="80" placeholder="留白，如 24px" data-batch-padding />
      <label class="selection-toggle"><input type="checkbox" data-batch-background />背景</label>
      <button class="button-secondary" type="button" data-apply-layout disabled><LayoutTemplate size={15} aria-hidden="true" />应用布局</button>
    </div>
    <button class="button-danger" type="button" data-delete-selected disabled><Trash2 size={15} aria-hidden="true" />批量删除</button>
    <p class="form-message" data-photo-message role="alert" hidden></p>
  </div>
  {
    photos.length ? (
      <div class="photo-grid" data-sortable-photos>
        {photos.map((photo) => (
          <article class="photo-card" data-id={photo.id} data-photo={JSON.stringify(photo)}>
            <div class="photo-thumbnail">
              <img src={photo.thumbnailUrl ?? photo.originalUrl} alt={photo.alt} loading="lazy" data-photo-image />
              <span class="photo-load-error">外链无法加载</span>
              <label class="photo-select"><input type="checkbox" value={photo.id} aria-label={`选择图片 ${photo.id}`} data-photo-select /></label>
              <button class="photo-drag" type="button" title="拖拽排序"><GripVertical size={17} aria-hidden="true" /><span class="sr-only">拖拽排序</span></button>
              <div class="photo-badges" data-photo-badges>
                {photo.sourceType === 'external' && <span><Link size={12} aria-hidden="true" />外链</span>}
                {coverPhotoId === photo.id && <span class="cover-badge"><Crown size={12} aria-hidden="true" />封面</span>}
              </div>
            </div>
            <div class="photo-card-footer">
              <div><strong data-card-title>{photo.alt || '未填写替代文本'}</strong><span data-card-meta>{photo.width && photo.height ? `${photo.width} × ${photo.height}` : '尺寸未知'}</span></div>
              <button class="icon-button" type="button" data-edit-photo title="编辑图片"><Pencil size={16} aria-hidden="true" /><span class="sr-only">编辑图片</span></button>
            </div>
          </article>
        ))}
      </div>
    ) : <div class="empty-state"><p>这个图集还没有图片。</p></div>
  }
</section>

<script>
  import Sortable from 'sortablejs';

  const library = document.querySelector<HTMLElement>('[data-photo-library]');
  const grid = library?.querySelector<HTMLElement>('[data-sortable-photos]');
  const selectAll = library?.querySelector<HTMLInputElement>('[data-select-all]');
  const deleteSelected = library?.querySelector<HTMLButtonElement>('[data-delete-selected]');
  const applyLayout = library?.querySelector<HTMLButtonElement>('[data-apply-layout]');
  const batchPreset = library?.querySelector<HTMLSelectElement>('[data-batch-preset]');
  const batchAlign = library?.querySelector<HTMLSelectElement>('[data-batch-align]');
  const batchPadding = library?.querySelector<HTMLInputElement>('[data-batch-padding]');
  const batchBackground = library?.querySelector<HTMLInputElement>('[data-batch-background]');
  const selectedCount = library?.querySelector<HTMLElement>('[data-selected-count]');
  const message = library?.querySelector<HTMLElement>('[data-photo-message]');
  const selections = () => Array.from(library?.querySelectorAll<HTMLInputElement>('[data-photo-select]:checked') ?? []);
  const syncSelection = () => {
    const selected = selections();
    if (selectedCount) selectedCount.textContent = `已选 ${selected.length} 张`;
    if (deleteSelected) deleteSelected.disabled = selected.length === 0;
    if (applyLayout) applyLayout.disabled = selected.length === 0;
    if (selectAll) {
      const all = library?.querySelectorAll('[data-photo-select]').length ?? 0;
      selectAll.checked = all > 0 && selected.length === all;
      selectAll.indeterminate = selected.length > 0 && selected.length < all;
    }
  };
  const setMessage = (value = '') => {
    if (!message) return;
    message.textContent = value;
    message.hidden = !value;
  };
  const persistOrder = async () => {
    if (!grid) return;
    const ids = Array.from(grid.querySelectorAll<HTMLElement>('[data-id]')).map((card) => Number(card.dataset.id));
    const response = await fetch('/api/admin/photos/reorder', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ albumId: Number(library?.dataset.albumId), ids }),
    });
    if (!response.ok) setMessage('排序保存失败，请刷新后重试。');
  };
  if (grid) Sortable.create(grid, { animation: 150, handle: '.photo-drag', onEnd: persistOrder });
  grid?.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
    const markFailed = () => image.closest('.photo-card')?.classList.add('has-load-error');
    image.addEventListener('error', markFailed);
    if (image.complete && image.naturalWidth === 0) markFailed();
  });
  library?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (input.matches('[data-select-all]')) library.querySelectorAll<HTMLInputElement>('[data-photo-select]').forEach((item) => item.checked = input.checked);
    syncSelection();
  });
  library?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('[data-edit-photo]');
    const card = button?.closest<HTMLElement>('[data-photo]');
    if (!card?.dataset.photo) return;
    const cards = Array.from(grid?.querySelectorAll<HTMLElement>('[data-photo]') ?? []);
    const index = cards.indexOf(card);
    const previous = index > 0 && cards[index - 1]?.dataset.photo
      ? JSON.parse(cards[index - 1]!.dataset.photo!)
      : undefined;
    const photo = JSON.parse(card.dataset.photo);
    const canPairWithNext = index >= 0 && index < cards.length - 1 && !previous?.layoutJson?.pairWithNext;
    document.dispatchEvent(new CustomEvent('photo:edit', { detail: { ...photo, canPairWithNext } }));
  });
  document.addEventListener('photo:updated', (event) => {
    const updated = (event as CustomEvent).detail;
    const card = library?.querySelector<HTMLElement>(`[data-photo][data-id="${updated.id}"]`);
    if (!card?.dataset.photo) return;
    const photo = { ...JSON.parse(card.dataset.photo), ...updated };
    card.dataset.photo = JSON.stringify(photo);
    card.dataset.layoutPreset = photo.layoutPreset;
    card.dataset.align = photo.align;
    card.dataset.background = String(Boolean(photo.hasBackground));
    const image = card.querySelector<HTMLImageElement>('[data-photo-image]');
    if (image) {
      image.src = photo.thumbnailUrl ?? photo.originalUrl;
      image.alt = photo.alt ?? '';
    }
    const title = card.querySelector<HTMLElement>('[data-card-title]');
    if (title) title.textContent = photo.alt || '未填写替代文本';
    if (photo.isCover) {
      library?.querySelectorAll('.cover-badge').forEach((badge) => badge.remove());
      const badges = card.querySelector<HTMLElement>('[data-photo-badges]');
      badges?.insertAdjacentHTML('beforeend', '<span class="cover-badge">封面</span>');
    }
  });
  applyLayout?.addEventListener('click', async () => {
    const selected = selections();
    if (!selected.length) return;
    applyLayout.disabled = true;
    setMessage();
    try {
      const response = await fetch('/api/admin/photos/batch-layout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          albumId: Number(library?.dataset.albumId),
          ids: selected.map((input) => Number(input.value)),
          layoutPreset: batchPreset?.value ?? 'auto',
          align: batchAlign?.value ?? 'center',
          hasBackground: batchBackground?.checked ?? false,
          padding: batchPadding?.value ?? '',
        }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error?.message ?? '批量布局保存失败。');
      result.data.forEach((photo: unknown) => document.dispatchEvent(new CustomEvent('photo:updated', { detail: photo })));
      setMessage(`已更新 ${result.data.length} 张图片的布局。`);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : '批量布局保存失败。');
    } finally {
      applyLayout.disabled = selections().length === 0;
    }
  });
  deleteSelected?.addEventListener('click', async () => {
    const selected = selections();
    if (!selected.length) return;
    deleteSelected.disabled = true;
    setMessage('正在检查特辑引用…');
    const details = await Promise.all(selected.map(async (input) => {
      const response = await fetch(`/api/admin/photos/${input.value}`);
      return response.ok ? (await response.json()).data : { specialReferenceCount: 0 };
    }));
    const specialReferenceCount = details.reduce((total, item) => total + Number(item.specialReferenceCount ?? 0), 0);
    const warning = specialReferenceCount > 0
      ? `\n其中有 ${specialReferenceCount} 个特辑区块正在引用这些图片；删除后相应区块会显示降级内容。`
      : '';
    if (!window.confirm(`确认删除选中的 ${selected.length} 张图片？${warning}`)) {
      deleteSelected.disabled = false;
      return setMessage();
    }
    deleteSelected.disabled = true;
    setMessage();
    const results = await Promise.all(selected.map((input) => fetch(`/api/admin/photos/${input.value}`, { method: 'DELETE' })));
    if (results.every((response) => response.ok)) {
      selected.forEach((input) => input.closest('[data-photo]')?.remove());
      syncSelection();
      return setMessage(`已删除 ${selected.length} 张图片。`);
    }
    setMessage('部分图片删除失败，请刷新后重试。');
    deleteSelected.disabled = false;
  });
  syncSelection();
</script>
