---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDatabase } from '../../server/db/client';
import { renderMarkdownSafe } from '../../server/markdown/render';
import { getPublishedPostBySlug } from '../../server/repositories/posts';

let post;
try {
  post = getPublishedPostBySlug(getDatabase(), Astro.params.slug ?? '');
} catch {
  return new Response(null, { status: 404 });
}
const content = await renderMarkdownSafe(post.markdown);
const title = post.seoTitle || post.title;
const description = post.seoDescription || post.excerpt;
---

<BaseLayout title={title} description={description} keywords="" showContact={false} showPreloader={false}>
  <div class="post">
    <main class="post-container">
      <div class="section-header">
        <div class="row">
          <div class="section-content m-auto">
            <div class="section-title">
              <div class="title-tag">BLOG</div>
              <h1 class="title">{post.title}</h1>
            </div>
          </div>
        </div>
        <div class="post-line post-line-bottom text-center">
          <span class="text-center">Last update: {(post.publishedAt ?? post.updatedAt).toISOString().slice(0, 10)}</span>
        </div>
      </div>

      <section>
        <div class="content" set:html={content}></div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .post-container { width: 100%; max-width: 65rem; margin: 7.5rem auto; min-height: calc(100vh - 88px); }
  .section-content, .section-desc { text-align: center; }
  .post-line-bottom { border-bottom: 1px dashed var(--color-600); padding-bottom: .75rem; margin: 1.5rem auto 3rem; font-size: .8rem; white-space: nowrap; color: var(--color-300); }
  .title-tag { display: inline-block; font-size: 13px; line-height: 1; margin: 16px auto 24px; border: 1px solid var(--color-300); border-radius: 36px; padding: 6px 22px; color: var(--color-300); text-align: center; font-family: var(--font-type); text-transform: uppercase; letter-spacing: 1px; }
  .title { font-size: 4rem; line-height: 1.2; margin: 1rem 0; color: var(--color-100); text-align: center; }
  .content { position: relative; color: var(--color-200); margin: 6rem auto 12rem; }
  .content :global(pre) { padding: 1.2em; border-radius: 6px; overflow: auto; }
  .content > :global(* + *) { margin-top: 1rem; }
  .content :global(h1), .content :global(h2), .content :global(h3), .content :global(h4), .content :global(h5) { margin: 1.75em 0 1em; color: var(--color-100); }
  .content :global(h1) { font-size: 2.5rem; }
  .content :global(h2) { font-size: 1.75rem; }
  .content :global(h3) { font-size: 1.5rem; }
  .content :global(h4) { font-size: 1.25rem; color: var(--color-200); }
  .content :global(h5) { font-size: 1rem; color: var(--color-300); }
  .content :global(img) { border-radius: 8px; max-width: 100%; height: auto; }
  .content :global(p) { margin: 16px 0; line-height: 1.75; }
  .content :global(blockquote) { font-size: var(--text-m); font-family: var(--font-brand); font-weight: 500; line-height: 1.1; padding-inline-start: 1.5rem; border-inline-start: .25rem solid var(--color-200); color: var(--color-400); }
  .content :global(a) { font-weight: 500; text-decoration: 1px solid underline transparent; text-underline-offset: .25em; transition: color .25s, opacity .25s; }
  .content :global(a:hover), .content :global(a:focus) { text-decoration-color: currentColor; }
  @media (max-width: 850px) { .title-tag { font-size: 12px; } }
  @media (max-width: 576px) { .title { font-size: 2.5rem; } .content :global(p) { line-height: 1.8; } }
</style>
