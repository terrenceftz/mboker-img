---
import Layout from "../layouts/Layout.astro";
import IndexCard from "../components/IndexCard.astro";
import Category from "../components/Category.astro";
import { getDatabase } from '../server/db/client';
import { listAlbumsPublished } from '../server/repositories/albums';
import { listCategoriesPublished } from '../server/repositories/categories';
import { getHomeData } from '../server/repositories/home';
import { listPhotos } from '../server/repositories/photos';
import { getSettings } from '../server/repositories/settings';

const db = getDatabase();
const home = getHomeData(db);
const settings = getSettings(db);
const homeHeroUrl = settings?.homeHeroUrl || '/hero01.jpg';
const homeSideUrl = settings?.homeSideUrl || '/hero02.jpg';
const categoryItems = listCategoriesPublished(db).map((category) => {
  const albums = listAlbumsPublished(db, category.id);
  const firstAlbum = albums[0];
  const albumPhotos = firstAlbum ? listPhotos(db, firstAlbum.id) : [];
  return {
    title: category.title,
    titleEn: category.titleEn,
    href: firstAlbum ? `/collection/${category.slug}/${firstAlbum.slug}` : `/collection/${category.slug}`,
    coverUrl: category.coverUrl ?? albumPhotos[0]?.thumbnailUrl ?? albumPhotos[0]?.originalUrl ?? null,
    photoCount: albums.reduce((total, album) => total + listPhotos(db, album.id).length, 0),
  };
});
const featuredAlbums = home.featuredAlbums.filter((album) => album.photos.length > 0);
const featuredItems = featuredAlbums.length
  ? Array.from({ length: Math.min(9, featuredAlbums.reduce((total, album) => total + album.photos.length, 0)) }, (_, index) => {
      const album = featuredAlbums[index % featuredAlbums.length]!;
      const photoIndex = Math.floor(index / featuredAlbums.length);
      const photo = album.photos[photoIndex % album.photos.length] ?? album.cover!;
      return {
        href: `/collection/${album.category.slug}/${album.slug}`,
        imageUrl: photo.originalUrl,
        alt: photo.alt || album.title,
        category: album.category.title,
        title: album.title,
        date: album.shotDate,
      };
    })
  : [];
---

<Layout
  page="home",
  title={settings?.defaultSeoTitle || "Mboker Img | 摄影与影像故事"}
  description={settings?.defaultSeoDescription || "欢迎来到 Mboker Img，记录城市、自然与旅途中的影像故事。"}
  keywords="Mboker Img,Photo,摄影,摄影学习日记,摄影师个人网站"
  loading="Mboker Img"
>
  <div class="container">
    <div class="hero">
      <div class="hero-header col-12 col-md-10 offset-md-2 p-0">
        <div class="hero-heading">
          <h1 class="hero-title" >
            <div class="splitting-title hero-splitting-title" data-splitting>
              {settings?.homeTitle || '影像故事'}
            </div>
           <div class="hero-line" aria-hidden="true">
             <img src="/mboker.png" alt="" class="mboker-signature" width="1759" height="527" />
           </div>
          </h1>
          <div class="user hero-byline" data-splitting>
            (Mboker Img)
          </div>
      </div>
        <p class="text col-10 col-sm-9 col-md-8  col-lg-7 col-xl-5  col-xxl-4 p-0 hero-text" data-splitting>
          {settings?.homeIntro || '每座城市都有其独特之处，人、事物、历史构成了一个繁复多彩的世界。我尝试将镜头对准身边心动的片刻，以自己的视角记录城市的魅力和瞬间的感知。'}
        </p>
      </div>
      <div class="hero-banner">
        <div class="side-img p-0">
          <picture class="gsap-picture side-picture p-0">
             <img src={homeSideUrl} alt="" class="side-picture__img" />
          </picture>
        </div>
        <div class="col-12 col-sm-10 col-md-10 col-lg-8 p-0">
          <div class="hero-01">
            <picture class="gsap-picture picture as__5-3">
              <img src={homeHeroUrl} alt="" class="picture__img hero-01"/>
            </picture>
          </div>
        </div>
      </div>
    </div>
  </div>
  <IndexCard items={featuredItems} />
  <Category items={categoryItems} />
</Layout>


<style lang="scss">
  .hero {
    margin-top: 120px;
    @media only screen and (min-width: 767px) {
      margin-top: 160px;
    }
    @media only screen and (min-width: 1200px) {
      margin-top: 180px;
    }
    &-banner {
      position: relative;
      padding-top: 12vw;
      @media only screen and (min-width: 601px) {
        padding-top: 120px;
      }
      @media only screen and (min-width: 1200px) {
        padding-top: 160px;
      }
    }
    &-header {
      p {
          font-size: 1rem;
        @media (min-width: 992px) {
          font-size: 20px;
        }
      }
    }
  }
  .hero-title {
    margin-bottom: 4rem;
    font-size: 108px;
    line-height: 1;
    filter: blur(0);
    opacity: 1;
    cursor: pointer;
    @media only screen and (max-width: 1025px) {
      font-size: 88px;
    }
    @media only screen and (max-width: 600px) {
      font-size: 15vw;
    }
    @media only screen and (max-width: 468px) {
      font-size: 15vw;
    }
  }
  .hero-title-2{
    opacity: 1;
    position: relative;
    line-height: 1;
    display: inline-block;
    margin-left: 8px;
  }
  .hero-title__motion{
    position: absolute;
    left: 0;
    top: 0;
    height: 110%;
    width: 0%;
    background-color: #000;
    transition: all 0.65s ease-in-out;
    cursor: pointer;
  }
  .hero-title:hover .hero-title__motion{
    width: 102%;
  }
  .hero-heading{
    display: flex;
    align-items: flex-start;
    .user{
      font-size: 16px;
      font-weight: 600;
      line-height: 1;
      text-align: left;
      margin-left: 20px;
      display: inline-block;
      margin-top: 10px;
      @media (min-width: 467px) {
        font-size: 16px;
        margin-left: 10px;
      }
      @media (min-width: 767px) {
        font-size: 24px;
      }
    }
  }
  .text {
    line-height: 1.6;
  }
  .side-img {
    position: relative;
    margin-top:2rem;
    width:100%;
    display: flex;
    justify-content: flex-end;
    text-align: right;
    margin-bottom:15vw;
    @media only screen and (min-width: 601px) {
      position: absolute;
      top: -6.5vw;
      right: 0;
      width: clamp(200px, 26vw, 460px);
      flex: 0 0 auto;
      text-align: right;
      margin:0;
    }
  }
  .side-picture{
    position:relative;
    display:inline-block;
    width: min(76vw, 360px);
    @media only screen and (min-width: 601px) {
      width: 100%;
    }
  }
  .side-picture__img{
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: all 0.5s ease-in-out;
  }
  .hero-splitting{
    filter: blur(0);
    opacity: 1;
  }
  .hero02 {
    margin-top: 180px;
  }
  .hero-line{
    position: absolute;
    right: -20%;
    top:20%;
    z-index:1;
    width: min(76vw, 608px);
    @media (min-width: 601px) {
      right: -45%;
      top:2%;
      z-index:1;
    }
  }
  .mboker-signature {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    will-change: clip-path, opacity;
    animation: none;
  }
  .hero-line.motion-svg__heroline .mboker-signature {
    animation: draw-mboker 10s ease-in-out infinite;
  }
  @keyframes draw-mboker {
    0%, 8% {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }
    10% {
      opacity: 1;
      clip-path: inset(0 100% 0 0);
    }
    34%, 58% {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
    64%, 100% {
      opacity: 0;
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mboker-signature {
      opacity: 1;
      clip-path: none;
      animation: none;
    }
  }
  .hero-01{
    @media (min-width: 601px) {
      margin-top:20px;
    }
  }

</style>
